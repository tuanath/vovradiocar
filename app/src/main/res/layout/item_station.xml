<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tile_height"
    android:layout_margin="6dp"
    android:background="@drawable/bg_glass"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tileShort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/accent_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tileDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#E6ECF5"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:id="@+id/tileDot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/bg_dot" />

    <ImageView
        android:id="@+id/tileFav"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="top|start"
        android:layout_margin="9dp"
        android:src="@drawable/ic_heart"
        android:visibility="gone" />
</FrameLayout>
